---
// Contador de visitas sem cookies → CRM (admin.adlerrochefort.com/api/site-track, tabela site_visits).
// Envia a página, a origem (referrer/UTM) e o momento; o servidor acrescenta país e tipo de dispositivo.
// Sem IP nem user-agent guardados. Identificador de sessão (sessionStorage) só com consentimento "Estatística".
// Para não contar as próprias visitas: abrir viagemgarantida.com/?nao-contar=1 uma vez em cada dispositivo.
---

<script>
    const ENDPOINT = 'https://admin.adlerrochefort.com/api/site-track';
    const HOST = 'viagemgarantida.com';

    function optedOut(): boolean {
        try {
            const p = new URLSearchParams(location.search);
            if (p.get('nao-contar') === '1') localStorage.setItem('vg-nao-contar', '1');
            if (p.get('nao-contar') === '0') localStorage.removeItem('vg-nao-contar');
            return localStorage.getItem('vg-nao-contar') === '1';
        } catch {
            return false;
        }
    }

    function sessionId(): string | null {
        try {
            const consent = JSON.parse(localStorage.getItem('vg-consent') ?? 'null');
            if (!consent?.analytics) return null;
            let sid = sessionStorage.getItem('vg-sid');
            if (!sid) {
                sid = crypto.randomUUID();
                sessionStorage.setItem('vg-sid', sid);
            }
            return sid;
        } catch {
            return null;
        }
    }

    function send(payload: Record<string, unknown>, beacon = false) {
        const body = JSON.stringify(payload);
        try {
            if (beacon && navigator.sendBeacon) {
                navigator.sendBeacon(ENDPOINT, new Blob([body], { type: 'text/plain' }));
                return;
            }
            fetch(ENDPOINT, { method: 'POST', body, keepalive: true, mode: 'cors', headers: { 'Content-Type': 'text/plain' } }).catch(() => {});
        } catch {}
    }

    if (location.hostname.replace(/^www\./, '') === HOST && !optedOut() && !(navigator as any).webdriver) {
        const visitId = crypto.randomUUID();
        const started = Date.now();
        send({
            action: 'visit-start',
            visitId,
            sessionId: sessionId(),
            path: location.pathname,
            url: location.href,
            referrer: document.referrer
        });
        let ended = false;
        const end = () => {
            if (ended) return;
            ended = true;
            send({ action: 'visit-end', visitId, url: location.href, durationSeconds: (Date.now() - started) / 1000 }, true);
        };
        document.addEventListener('visibilitychange', () => document.visibilityState === 'hidden' && end());
        window.addEventListener('pagehide', end);
    }
</script>
