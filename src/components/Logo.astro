---
interface Props {
    inverted?: boolean;
    class?: string;
}
const { inverted = false, class: className = 'h-14 w-auto' } = Astro.props;
---

<picture>
    {inverted ? <source srcset="/brand/logo-white.webp" type="image/webp" /> : <source srcset="/brand/logo.webp" type="image/webp" />}
    <img
        src={inverted ? '/brand/logo-white.png' : '/brand/logo-480.png'}
        alt="Viagem Garantida"
        width="480"
        height="306"
        class={className}
        decoding="async"
    />
</picture>
