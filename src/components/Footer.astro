---
import Logo from './Logo.astro';
import { getCollection } from 'astro:content';
import { SITE, OPERATOR, PARTNER, CATEGORIES } from '../site';

const destinos = (await getCollection('destinos')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);

const year = new Date().getFullYear();
---

<footer class="mt-24 bg-ink text-paper/80">
    <div class="container-vg grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
        <div>
            <Logo inverted class="h-24 w-auto" />
            <p class="mt-5 max-w-sm text-sm leading-relaxed text-paper/70">{SITE.tagline}</p>
            <div class="mt-6 space-y-1 text-sm">
                <p><a class="text-paper hover:text-sunset" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
                <p><a class="text-paper hover:text-sunset" href={SITE.phoneHref}>{SITE.phone}</a></p>
            </div>
        </div>

        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sunset">Guias</p>
            <ul class="mt-4 space-y-2 text-sm">
                {
                    Object.entries(CATEGORIES).map(([key, label]) => (
                        <li>
                            <a class="hover:text-sunset" href={`/blog/categoria/${key}`}>
                                {label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sunset">Destinos</p>
            <ul class="mt-4 space-y-2 text-sm">
                {
                    destinos.map((d) => (
                        <li>
                            <a class="hover:text-sunset" href={`/seguro-viagem/${d.id}`}>
                                Seguro viagem {d.data.country}
                            </a>
                        </li>
                    ))
                }
                <li><a class="hover:text-sunset" href="/seguro-viagem">Todos os destinos</a></li>
            </ul>
        </div>

        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sunset">Informação</p>
            <ul class="mt-4 space-y-2 text-sm">
                <li><a class="hover:text-sunset" href="/cotacao">Comparar seguros</a></li>
                <li><a class="hover:text-sunset" href="/sobre">Quem somos</a></li>
                <li><a class="hover:text-sunset" href="/termos">Termos e condições</a></li>
                <li><a class="hover:text-sunset" href="/privacidade">Política de privacidade</a></li>
                <li><a class="hover:text-sunset" href="/cookies">Política de cookies</a></li>
                <li><button type="button" data-cookie-settings class="hover:text-sunset">Definições de cookies</button></li>
                <li>
                    <a class="hover:text-sunset" href="https://www.livroreclamacoes.pt" target="_blank" rel="noopener">Livro de Reclamações</a>
                </li>
            </ul>
        </div>
    </div>

    <div class="border-t border-paper/10">
        <div class="container-vg py-8 text-xs leading-relaxed text-paper/55">
            <p>
                {SITE.name} é uma marca da {OPERATOR.legalName} ({OPERATOR.address}) e uma plataforma de informação e marketing sobre seguros de viagem.
                A {SITE.name} não é seguradora, não vende seguros e não atua como mediador nos contratos apresentados.
                Os seguros são comercializados pela {PARTNER.legalName} ({PARTNER.name}), intermediário de seguros registado em França no ORIAS com o n.º {PARTNER.orias},
                junto de quem decorrem a subscrição, o pagamento e o apoio ao cliente. A {SITE.name} é remunerada pela {PARTNER.name} por cada seguro subscrito através do site.
                As coberturas, capitais e exclusões de cada seguro constam do IPID e das condições gerais e particulares da respetiva apólice.
            </p>
            <p class="mt-4">© {year} {OPERATOR.legalName}. Todos os direitos reservados.</p>
        </div>
    </div>
</footer>
