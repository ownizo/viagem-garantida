---
const currentYear = new Date().getFullYear();
---

<footer class="bg-dark text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
            <!-- Brand -->
            <div class="lg:col-span-1">
                <img
                    src="/images/viagemgarantida_horizontal.png"
                    alt="Viagem Garantida"
                    class="h-12 w-auto mb-4 brightness-0 invert"
                />
                <p class="text-sm text-gray-300 leading-relaxed mt-4">
                    Seguros de viagem para parceiros B2B. Proteja os seus clientes com as melhores coberturas do mercado.
                </p>
            </div>

            <!-- Contact -->
            <div>
                <h4 class="font-bold text-secondary mb-4 text-sm uppercase tracking-wider">Contacto</h4>
                <ul class="space-y-3 text-sm text-gray-300">
                    <li class="flex items-start gap-2">
                        <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <a href="mailto:geral@viagemsegura.com" class="footer-link hover:text-primary transition-colors">geral@viagemsegura.com</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        <a href="tel:+351928226570" class="footer-link hover:text-primary transition-colors">+351 928 226 570</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span>Avenida do Atlântico 16,<br />Escritório 5.07<br />1990-019 Lisboa</span>
                    </li>
                </ul>
            </div>

            <!-- Links -->
            <div>
                <h4 class="font-bold text-secondary mb-4 text-sm uppercase tracking-wider">Legal</h4>
                <ul class="space-y-3 text-sm text-gray-300">
                    <li>
                        <a href="/politica-privacidade" class="footer-link hover:text-primary transition-colors">Política de Privacidade</a>
                    </li>
                    <li>
                        <a href="/termos-condicoes" class="footer-link hover:text-primary transition-colors">Termos e Condições</a>
                    </li>
                    <li>
                        <a href="https://www.livroreclamacoes.pt" target="_blank" rel="noopener noreferrer" class="footer-link hover:text-primary transition-colors">
                            Livro de Reclamações Online
                            <svg class="inline-block w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Compliance -->
            <div>
                <h4 class="font-bold text-secondary mb-4 text-sm uppercase tracking-wider">Informação Legal</h4>
                <p class="text-xs text-gray-400 leading-relaxed">
                    Viagem Garantida é marca comercial da empresa <strong class="text-gray-300">Ownizo Unipessoal Lda</strong>, com NIF 517169029 e registo na ASF n.º 425591790/3.
                </p>
            </div>
        </div>

        <div class="border-t border-gray-700 mt-12 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
            <p class="text-xs text-gray-400">
                &copy; {currentYear} Viagem Garantida. Todos os direitos reservados.
            </p>
            <p class="text-xs text-gray-500">
                Ownizo Unipessoal Lda · NIF 517169029 · ASF 425591790/3
            </p>
        </div>
    </div>
</footer>
