---
// Formulário completo de pedido de cotação. Envia JSON para /api/quote.
// Na fase 2, quando a API devolver ofertas (status 'offers'), são apresentadas aqui.
---

<form id="quote-form" class="card relative space-y-8 bg-white p-6 sm:p-10" novalidate>
    <fieldset class="space-y-5">
        <legend class="mb-4 flex items-center gap-3 text-lg font-bold">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-sunset text-sm text-white">1</span> A viagem
        </legend>
        <div class="grid gap-5 sm:grid-cols-2">
            <div>
                <label class="field-label" for="region">Zona de destino</label>
                <select class="field" id="region" name="region" required>
                    <option value="europa">Europa</option>
                    <option value="mundo-sem-eua">Mundo (exceto EUA e Canadá)</option>
                    <option value="mundo-com-eua">Mundo (incluindo EUA e Canadá)</option>
                </select>
            </div>
            <div>
                <label class="field-label" for="destination">País(es) de destino</label>
                <input class="field" id="destination" name="destination" placeholder="Ex.: Japão e Coreia do Sul" required />
            </div>
            <div>
                <label class="field-label" for="departureDate">Partida</label>
                <input class="field" type="date" id="departureDate" name="departureDate" required />
            </div>
            <div>
                <label class="field-label" for="returnDate">Regresso</label>
                <input class="field" type="date" id="returnDate" name="returnDate" required />
            </div>
            <div class="sm:col-span-2">
                <label class="field-label" for="purpose">Motivo da viagem</label>
                <select class="field" id="purpose" name="purpose">
                    <option value="lazer">Férias e lazer</option>
                    <option value="estudos">Estudos (Erasmus, intercâmbio, universidade)</option>
                    <option value="trabalho">Trabalho ou negócios</option>
                    <option value="longa-duracao">Estadia longa (mais de 3 meses)</option>
                </select>
            </div>
        </div>
    </fieldset>

    <fieldset class="space-y-5">
        <legend class="mb-4 flex items-center gap-3 text-lg font-bold">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-sunset text-sm text-white">2</span> Quem viaja
        </legend>
        <p class="-mt-2 text-sm text-ink-soft">Indique a idade de cada viajante na data de partida.</p>
        <div id="travellers" class="flex flex-wrap gap-3"></div>
        <button type="button" id="add-traveller" class="btn-ghost !py-2 text-xs">+ Adicionar viajante</button>
    </fieldset>

    <fieldset class="space-y-5">
        <legend class="mb-4 flex items-center gap-3 text-lg font-bold">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-sunset text-sm text-white">3</span> Cancelamento
        </legend>
        <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-ink/10 bg-paper/60 p-4">
            <input type="checkbox" id="cancellation" name="cancellation" class="mt-1 h-5 w-5 accent-[#e8743b]" />
            <span class="text-sm leading-relaxed">
                <strong class="block text-ink">Quero cobertura de cancelamento</strong>
                Reembolso das despesas já pagas se tiver de cancelar por um motivo coberto (doença, acidente, falecimento de familiar, entre outros).
            </span>
        </label>
        <div id="trip-cost-wrap" class="hidden max-w-xs">
            <label class="field-label" for="tripCostPerPerson">Custo da viagem por pessoa (€)</label>
            <input class="field" type="number" min="0" step="50" id="tripCostPerPerson" name="tripCostPerPerson" placeholder="Ex.: 2500" />
        </div>
    </fieldset>

    <fieldset class="space-y-5">
        <legend class="mb-4 flex items-center gap-3 text-lg font-bold">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-sunset text-sm text-white">4</span> Contacto
        </legend>
        <div class="grid gap-5 sm:grid-cols-2">
            <div>
                <label class="field-label" for="name">Nome</label>
                <input class="field" id="name" name="name" autocomplete="name" required />
            </div>
            <div>
                <label class="field-label" for="email">Email</label>
                <input class="field" type="email" id="email" name="email" autocomplete="email" required />
            </div>
            <div>
                <label class="field-label" for="phone">Telemóvel <span class="normal-case tracking-normal text-ink/40">(opcional)</span></label>
                <input class="field" type="tel" id="phone" name="phone" autocomplete="tel" />
            </div>
            <div class="sm:col-span-2">
                <label class="field-label" for="notes">Informação adicional <span class="normal-case tracking-normal text-ink/40">(opcional)</span></label>
                <textarea class="field min-h-[110px]" id="notes" name="notes" placeholder="Desportos de aventura, gravidez, condições de saúde a declarar, exigências da universidade ou do visto…"></textarea>
            </div>
        </div>
        <div class="hidden" aria-hidden="true">
            <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <label class="flex cursor-pointer items-start gap-3 text-sm leading-relaxed text-ink-soft">
            <input type="checkbox" id="privacy" name="privacy" required class="mt-1 h-5 w-5 accent-[#e8743b]" />
            <span>Aceito que os meus dados sejam tratados para a preparação da cotação, nos termos da <a href="/privacidade" class="font-semibold text-sunset-deep underline">política de privacidade</a>.</span>
        </label>
    </fieldset>

    <div id="form-error" class="hidden rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert"></div>

    <div class="flex flex-col gap-4 border-t border-ink/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-xs leading-relaxed text-ink-soft">Sem compromisso. A proposta é enviada por email.</p>
        <button type="submit" class="btn-sunset px-8 py-4 text-base" id="submit-btn">Pedir cotação</button>
    </div>
</form>

<div id="quote-success" class="card hidden bg-white p-10 text-center" role="status" aria-live="polite">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-sea/10">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" stroke="#2A7F7A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </div>
    <h2 class="mt-6 text-2xl sm:text-3xl">Pedido recebido</h2>
    <p class="mx-auto mt-3 max-w-md text-ink-soft">
        Obrigado. Vamos analisar a sua viagem e enviar-lhe por email uma proposta com as coberturas adequadas.
    </p>
    <p class="mt-6 inline-block rounded-full bg-paper px-5 py-2 font-mono text-sm">Referência: <strong id="quote-ref"></strong></p>
    <div id="quote-offers" class="mt-8 hidden space-y-4 text-left"></div>
</div>

<script>
    const form = document.getElementById('quote-form') as HTMLFormElement | null;
    const travellersBox = document.getElementById('travellers')!;
    const addBtn = document.getElementById('add-traveller')!;
    const cancel = document.getElementById('cancellation') as HTMLInputElement;
    const costWrap = document.getElementById('trip-cost-wrap')!;
    const errorBox = document.getElementById('form-error')!;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    const params = new URLSearchParams(location.search);
    const today = new Date().toISOString().slice(0, 10);

    function addTraveller(age = '') {
        const n = travellersBox.children.length + 1;
        const wrap = document.createElement('div');
        wrap.className = 'flex items-center gap-2 rounded-2xl border border-ink/10 bg-paper/60 py-2 pl-4 pr-2';
        wrap.innerHTML = `<label class="text-xs font-semibold text-ink-soft" for="age-${n}">Viajante ${n}</label>
            <input id="age-${n}" class="field !w-24 !px-2 !py-2 text-center" type="number" min="0" max="99" placeholder="anos" data-age required value="${age}">
            <button type="button" class="h-8 w-8 rounded-full text-ink/40 hover:bg-white hover:text-ink" aria-label="Remover viajante ${n}">×</button>`;
        wrap.querySelector('button')!.addEventListener('click', () => {
            if (travellersBox.children.length > 1) wrap.remove();
        });
        travellersBox.appendChild(wrap);
    }

    if (form) {
        // Pré-preenchimento a partir do mini-formulário da página inicial
        const count = Math.min(Math.max(Number(params.get('viajantes')) || 1, 1), 10);
        for (let i = 0; i < count; i++) addTraveller();
        for (const key of ['region', 'destination', 'departureDate', 'returnDate', 'purpose'] as const) {
            const v = params.get(key);
            const el = form.elements.namedItem(key) as HTMLInputElement | null;
            if (v && el) el.value = v;
        }
        if (params.get('cancelamento') === '1') cancel.checked = true;
        costWrap.classList.toggle('hidden', !cancel.checked);

        (form.elements.namedItem('departureDate') as HTMLInputElement).min = today;
        (form.elements.namedItem('returnDate') as HTMLInputElement).min = today;

        addBtn.addEventListener('click', () => travellersBox.children.length < 10 && addTraveller());
        cancel.addEventListener('change', () => costWrap.classList.toggle('hidden', !cancel.checked));

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            errorBox.classList.add('hidden');
            if (!form.reportValidity()) return;

            const f = new FormData(form);
            const ages = [...travellersBox.querySelectorAll<HTMLInputElement>('[data-age]')].map((i) => ({ age: Number(i.value) }));
            const source: Record<string, string> = { page: location.pathname };
            for (const k of ['utm_source', 'utm_medium', 'utm_campaign']) if (params.get(k)) source[k] = params.get(k)!;

            const payload = {
                region: f.get('region'),
                destination: f.get('destination'),
                departureDate: f.get('departureDate'),
                returnDate: f.get('returnDate'),
                purpose: f.get('purpose'),
                travellers: ages,
                cancellation: cancel.checked,
                tripCostPerPerson: cancel.checked && f.get('tripCostPerPerson') ? Number(f.get('tripCostPerPerson')) : undefined,
                contact: { name: f.get('name'), email: f.get('email'), phone: (f.get('phone') as string) || undefined },
                notes: (f.get('notes') as string) || undefined,
                privacy: (form.elements.namedItem('privacy') as HTMLInputElement).checked,
                website: (f.get('website') as string) || undefined,
                source
            };

            submitBtn.disabled = true;
            submitBtn.textContent = 'A enviar…';
            try {
                const res = await fetch('/api/quote', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                const data = await res.json();
                if (!data.ok) {
                    const details = (data.fieldErrors ?? []).map((x: { message: string }) => x.message).join(' · ');
                    throw new Error(details || data.error || 'Não foi possível enviar o pedido.');
                }
                document.getElementById('quote-ref')!.textContent = data.result.reference;
                form.classList.add('hidden');
                document.getElementById('quote-success')!.classList.remove('hidden');
                document.getElementById('quote-success')!.scrollIntoView({ behavior: 'smooth', block: 'center' });
                // Fase 2: renderizar data.result.offers quando status === 'offers'
            } catch (err) {
                errorBox.textContent = (err as Error).message || 'Ocorreu um erro. Tente novamente ou contacte-nos por email.';
                errorBox.classList.remove('hidden');
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Pedir cotação';
            }
        });
    }
</script>
