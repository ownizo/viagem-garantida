---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../site';

interface Props {
    post: CollectionEntry<'blog'>;
    large?: boolean;
}
const { post, large = false } = Astro.props;
const tones: Record<string, string> = {
    familias: 'from-[#f3d9c4] to-[#f6f1e7]',
    estudantes: 'from-[#dfeaf0] to-[#f6f1e7]',
    destinos: 'from-[#d6e8e4] to-[#f6f1e7]',
    coberturas: 'from-[#e6e1f0] to-[#f6f1e7]',
    cancelamento: 'from-[#f1e3c8] to-[#f6f1e7]'
};
---

<a href={`/blog/${post.id}`} class="group flex h-full flex-col overflow-hidden rounded-3xl border border-ink/10 bg-white/70 transition hover:-translate-y-1 hover:shadow-[0_18px_40px_-20px_rgba(20,33,61,0.35)]">
    <div class:list={['relative flex items-end bg-gradient-to-br p-6', tones[post.data.category], large ? 'h-48' : 'h-32']}>
        <span class="rounded-full bg-white/80 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.15em] text-ink">{CATEGORIES[post.data.category]}</span>
        <span class="route-line absolute right-6 top-6 h-1 w-20 text-sunset/60" aria-hidden="true"></span>
    </div>
    <div class="flex grow flex-col p-6">
        <h3 class:list={['leading-snug transition group-hover:text-sunset-deep', large ? 'text-2xl' : 'text-lg']}>{post.data.title}</h3>
        <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink-soft">{post.data.description}</p>
        <p class="mt-auto pt-5 text-xs font-medium text-ink/50">{post.data.readingTime} min de leitura</p>
    </div>
</a>
