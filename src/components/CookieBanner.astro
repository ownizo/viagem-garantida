---
// Banner de consentimento de cookies (RGPD / Lei n.º 41/2004).
// Escolha guardada em localStorage "vg-consent" (12 meses). Scripts de estatística ou marketing
// futuros devem ouvir o evento "vg:consent" ou ler window.vgConsent antes de carregar.
---

<div id="cookie-banner" class="fixed inset-x-0 bottom-0 z-50 hidden p-4 sm:p-6" role="dialog" aria-live="polite" aria-labelledby="cookie-title">
    <div class="mx-auto max-w-4xl rounded-3xl border border-ink/10 bg-white p-6 shadow-[0_20px_60px_-20px_rgba(20,33,61,0.45)] sm:p-8">
        <div id="cookie-main">
            <h2 id="cookie-title" class="text-lg">Cookies</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                Usamos apenas o armazenamento estritamente necessário e um contador de visitas sem cookies. Com a sua autorização, guardamos também um identificador de sessão para estatísticas e poderemos usar cookies de marketing para medir campanhas. Pode alterar a escolha a qualquer momento.
                <a href="/cookies" class="font-semibold text-sunset-deep underline">Política de cookies</a>
            </p>
            <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:justify-end">
                <button type="button" data-cc="customize" class="btn-ghost">Personalizar</button>
                <button type="button" data-cc="reject" class="btn-primary">Rejeitar</button>
                <button type="button" data-cc="accept" class="btn-primary">Aceitar todos</button>
            </div>
        </div>

        <div id="cookie-custom" class="hidden">
            <h2 class="text-lg">Preferências de cookies</h2>
            <div class="mt-4 divide-y divide-ink/10 text-sm">
                <label class="flex items-start justify-between gap-6 py-3">
                    <span><strong class="block text-ink">Estritamente necessários</strong><span class="text-ink-soft">Guardam a sua escolha e asseguram o funcionamento do site. Sempre ativos.</span></span>
                    <input type="checkbox" checked disabled class="mt-1 h-5 w-5 accent-[#E2600F]" />
                </label>
                <label class="flex cursor-pointer items-start justify-between gap-6 py-3">
                    <span><strong class="block text-ink">Estatística</strong><span class="text-ink-soft">Medição agregada da utilização do site.</span></span>
                    <input type="checkbox" id="cc-analytics" class="mt-1 h-5 w-5 accent-[#E2600F]" />
                </label>
                <label class="flex cursor-pointer items-start justify-between gap-6 py-3">
                    <span><strong class="block text-ink">Marketing</strong><span class="text-ink-soft">Medição de campanhas e publicidade noutras plataformas.</span></span>
                    <input type="checkbox" id="cc-marketing" class="mt-1 h-5 w-5 accent-[#E2600F]" />
                </label>
            </div>
            <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:justify-end">
                <button type="button" data-cc="reject" class="btn-ghost">Rejeitar todos</button>
                <button type="button" data-cc="save" class="btn-primary">Guardar escolhas</button>
            </div>
        </div>
    </div>
</div>

<script>
    type Consent = { v: 1; necessary: true; analytics: boolean; marketing: boolean; ts: string };
    const KEY = 'vg-consent';
    const MAX_AGE = 365 * 24 * 3600 * 1000;
    const banner = document.getElementById('cookie-banner')!;
    const main = document.getElementById('cookie-main')!;
    const custom = document.getElementById('cookie-custom')!;
    const analytics = document.getElementById('cc-analytics') as HTMLInputElement;
    const marketing = document.getElementById('cc-marketing') as HTMLInputElement;

    function read(): Consent | null {
        try {
            const c = JSON.parse(localStorage.getItem(KEY) ?? 'null') as Consent | null;
            if (!c || c.v !== 1 || Date.now() - Date.parse(c.ts) > MAX_AGE) return null;
            return c;
        } catch {
            return null;
        }
    }
    function apply(c: Consent) {
        (window as any).vgConsent = c;
        const g = (window as any).gtag;
        if (typeof g === 'function') {
            const m = c.marketing ? 'granted' : 'denied';
            g('consent', 'update', { analytics_storage: c.analytics ? 'granted' : 'denied', ad_storage: m, ad_user_data: m, ad_personalization: m });
        }
        window.dispatchEvent(new CustomEvent('vg:consent', { detail: c }));
    }
    function save(a: boolean, m: boolean) {
        const c: Consent = { v: 1, necessary: true, analytics: a, marketing: m, ts: new Date().toISOString() };
        try {
            localStorage.setItem(KEY, JSON.stringify(c));
        } catch {}
        apply(c);
        banner.classList.add('hidden');
    }
    function open(customize = false) {
        const c = read();
        analytics.checked = c?.analytics ?? false;
        marketing.checked = c?.marketing ?? false;
        main.classList.toggle('hidden', customize);
        custom.classList.toggle('hidden', !customize);
        banner.classList.remove('hidden');
    }

    banner.addEventListener('click', (e) => {
        const action = (e.target as HTMLElement).closest<HTMLElement>('[data-cc]')?.dataset.cc;
        if (action === 'accept') save(true, true);
        else if (action === 'reject') save(false, false);
        else if (action === 'save') save(analytics.checked, marketing.checked);
        else if (action === 'customize') open(true);
    });
    document.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-cookie-settings]')) {
            e.preventDefault();
            open(true);
        }
    });

    const existing = read();
    if (existing) apply(existing);
    else open(false);
</script>
