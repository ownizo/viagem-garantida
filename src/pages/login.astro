const SITE_PASSWORD = import.meta.env.SITE_PASSWORD || 'viagemgarantida2026';

// Handle form submission
let error = '';
if (Astro.request.method === 'POST') {
    const formData = await Astro.request.formData();
    const password = formData.get('password')?.toString() || '';

    if (password === SITE_PASSWORD) {
        // Set auth cookie
        const token = generateToken(SITE_PASSWORD);
        Astro.cookies.set('vg_auth', token, {
            path: '/',
            httpOnly: true,
            secure: true,
            sameSite: 'lax',
            maxAge: 60 * 60 * 24 * 30 // 30 days
        });
        return Astro.redirect('/');
    } else {
        error = 'Password incorreta. Tente novamente.';
    }
}

function generateToken(password: string): string {
    let hash = 0;
    const str = `vg_${password}_secure`;
    for (let i = 0; i < str.length; i++) {
        const char = str.charCodeAt(i);
        hash = ((hash << 5) - hash) + char;
        hash |= 0;
    }
    return Math.abs(hash).toString(36);
}
