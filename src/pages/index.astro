---
import Layout from '../layouts/Layout.astro';

const coverages = [
    {
        icon: '🏥',
        title: 'Despesas Médicas',
        description: 'Cobertura completa para despesas médicas, hospitalares e de repatriamento em qualquer destino do mundo.'
    },
    {
        icon: '✈️',
        title: 'Cancelamento de Viagem',
        description: 'Proteção financeira em caso de cancelamento ou interrupção da viagem por motivos imprevistos.'
    },
    {
        icon: '🧳',
        title: 'Bagagem',
        description: 'Cobertura para perda, roubo ou danos à bagagem e pertences pessoais durante a viagem.'
    },
    {
        icon: '⚖️',
        title: 'Responsabilidade Civil',
        description: 'Proteção contra danos causados a terceiros durante a estadia no estrangeiro.'
    },
    {
        icon: '🚨',
        title: 'Assistência 24h',
        description: 'Linha de assistência disponível 24 horas por dia, 7 dias por semana, em qualquer parte do mundo.'
    },
    {
        icon: '📋',
        title: 'Soluções Personalizadas',
        description: 'Planos ajustados às necessidades do seu negócio, com coberturas e limites flexíveis.'
    }
];

const steps = [
    {
        number: '01',
        title: 'Contacte-nos',
        description: 'Entre em contacto com a nossa equipa para discutir as necessidades dos seus clientes.'
    },
    {
        number: '02',
        title: 'Proposta Personalizada',
        description: 'Receba uma proposta à medida com coberturas e preços adaptados ao seu volume de negócio.'
    },
    {
        number: '03',
        title: 'Integração Simples',
        description: 'Integramos a nossa solução na sua plataforma de forma rápida e sem complicações.'
    },
    {
        number: '04',
        title: 'Comece a Vender',
        description: 'Ofereça seguros de viagem aos seus clientes e beneficie de comissões atrativas.'
    }
];
---

<Layout title="Seguros de Viagem B2B">
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-dark via-dark-light to-dark overflow-hidden">
        <div class="absolute inset-0 opacity-10">
            <div class="absolute top-0 right-0 w-96 h-96 bg-primary rounded-full blur-3xl translate-x-1/2 -translate-y-1/2"></div>
            <div class="absolute bottom-0 left-0 w-96 h-96 bg-secondary rounded-full blur-3xl -translate-x-1/2 translate-y-1/2"></div>
        </div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 lg:py-40">
            <div class="max-w-3xl">
                <span class="inline-block bg-primary/20 text-primary font-semibold text-sm px-4 py-1.5 rounded-full mb-6">
                    Plataforma B2B de Seguros de Viagem
                </span>
                <h1 class="text-white text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
                    Proteja os clientes dos seus parceiros com <span class="text-secondary">seguros de viagem</span> de confiança.
                </h1>
                <p class="text-gray-300 text-lg sm:text-xl leading-relaxed mb-10 max-w-2xl">
                    Soluções de seguro de viagem pensadas para agências, operadores turísticos e plataformas digitais. Coberturas abrangentes, preços competitivos e integração simples.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="#contacto" class="btn btn-secondary btn-lg no-underline">
                        Pedir Proposta
                    </a>
                    <a href="#coberturas" class="btn btn-outline btn-lg no-underline border-white text-white hover:bg-white hover:text-dark">
                        Ver Coberturas
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Trust Bar -->
    <section class="bg-white py-8 border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-wrap justify-center items-center gap-8 sm:gap-16 text-sm text-dark-light font-medium">
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Registado na ASF</span>
                </div>
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Cobertura Mundial</span>
                </div>
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Assistência 24/7</span>
                </div>
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Parceiros de Confiança</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Coverages Section -->
    <section id="coberturas" class="py-20 sm:py-28 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-primary font-semibold text-sm uppercase tracking-wider">Coberturas</span>
                <h2 class="mt-3 text-dark">Proteção completa para cada viagem</h2>
                <p class="mt-4 text-dark-light text-lg">
                    Oferecemos uma gama completa de coberturas para garantir que os seus clientes viajam com total tranquilidade.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {coverages.map((item) => (
                    <div class="card border border-gray-100">
                        <div class="text-4xl mb-4">{item.icon}</div>
                        <h3 class="text-lg font-bold text-dark mb-3">{item.title}</h3>
                        <p class="text-dark-light text-sm leading-relaxed">{item.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- How it Works -->
    <section id="como-funciona" class="py-20 sm:py-28 bg-cream">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-primary font-semibold text-sm uppercase tracking-wider">Como Funciona</span>
                <h2 class="mt-3 text-dark">Comece em 4 passos simples</h2>
                <p class="mt-4 text-dark-light text-lg">
                    Torne-se parceiro Viagem Garantida e comece a oferecer seguros de viagem aos seus clientes.
                </p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                {steps.map((step) => (
                    <div class="text-center">
                        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary text-white font-bold text-xl mb-5">
                            {step.number}
                        </div>
                        <h3 class="text-lg font-bold text-dark mb-3">{step.title}</h3>
                        <p class="text-dark-light text-sm leading-relaxed">{step.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Why Us -->
    <section class="py-20 sm:py-28 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div>
                    <span class="text-primary font-semibold text-sm uppercase tracking-wider">Porquê a Viagem Garantida</span>
                    <h2 class="mt-3 text-dark">O parceiro certo para o seu negócio</h2>
                    <p class="mt-4 text-dark-light text-lg leading-relaxed">
                        Com a Viagem Garantida, tem acesso a uma plataforma completa de seguros de viagem desenhada para profissionais do turismo.
                    </p>
                    <ul class="mt-8 space-y-4">
                        <li class="flex items-start gap-3">
                            <svg class="w-6 h-6 text-secondary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <strong class="text-dark">Comissões Competitivas</strong>
                                <p class="text-sm text-dark-light mt-1">Margens atrativas que premiam o seu volume de vendas.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <svg class="w-6 h-6 text-secondary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <strong class="text-dark">Gestão Simplificada</strong>
                                <p class="text-sm text-dark-light mt-1">Plataforma intuitiva para gestão de apólices e sinistros.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <svg class="w-6 h-6 text-secondary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <strong class="text-dark">Suporte Dedicado</strong>
                                <p class="text-sm text-dark-light mt-1">Equipa de account managers dedicada ao seu sucesso.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <svg class="w-6 h-6 text-secondary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <strong class="text-dark">Integração API</strong>
                                <p class="text-sm text-dark-light mt-1">API robusta para integração direta nos seus sistemas.</p>
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="bg-gradient-to-br from-primary/10 to-secondary/10 rounded-3xl p-12 flex items-center justify-center">
                    <img
                        src="/images/viagemgarantida_principal@2x.png"
                        alt="Viagem Garantida"
                        class="max-w-xs w-full"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Contact / CTA Section -->
    <section id="contacto" class="py-20 sm:py-28 bg-gradient-to-br from-dark via-dark-light to-dark">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-2xl mx-auto text-center">
                <span class="text-secondary font-semibold text-sm uppercase tracking-wider">Contacte-nos</span>
                <h2 class="mt-3 text-white">Pronto para ser nosso parceiro?</h2>
                <p class="mt-4 text-gray-300 text-lg leading-relaxed">
                    Entre em contacto com a nossa equipa comercial e descubra como a Viagem Garantida pode impulsionar o seu negócio.
                </p>
                <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6">
                    <a href="mailto:geral@viagemsegura.com" class="card bg-white/10 backdrop-blur border border-white/20 text-center no-underline group hover:bg-white/20">
                        <svg class="w-8 h-8 mx-auto text-secondary mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <p class="text-white font-semibold text-sm">Email</p>
                        <p class="text-gray-300 text-sm mt-1">geral@viagemsegura.com</p>
                    </a>
                    <a href="tel:+351928226570" class="card bg-white/10 backdrop-blur border border-white/20 text-center no-underline group hover:bg-white/20">
                        <svg class="w-8 h-8 mx-auto text-secondary mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        <p class="text-white font-semibold text-sm">Telefone</p>
                        <p class="text-gray-300 text-sm mt-1">+351 928 226 570</p>
                    </a>
                    <div class="card bg-white/10 backdrop-blur border border-white/20 text-center hover:bg-white/20">
                        <svg class="w-8 h-8 mx-auto text-secondary mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <p class="text-white font-semibold text-sm">Morada</p>
                        <p class="text-gray-300 text-sm mt-1">Av. do Atlântico 16, Esc. 5.07<br/>1990-019 Lisboa</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
