---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SITE } from '../site';
import { COUNTRIES } from '../lib/countries';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.filter((p) => p.data.featured).slice(0, 3);

const audiences = [
    { title: 'Famílias', text: 'Uma apólice para todos, com acompanhamento de menores, regresso antecipado e cancelamento à medida do valor da viagem.', href: '/blog/seguro-viagem-familias', icon: 'M7 20a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm10 0a3 3 0 1 1 0-6 3 3 0 0 1 0 6ZM12 9a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z' },
    { title: 'Estudantes', text: 'Erasmus, intercâmbio, universidade ou estágio. Seguros de longa duração que cumprem os requisitos da instituição.', href: '/blog/seguro-viagem-estudantes-erasmus', icon: 'M3 9l9-5 9 5-9 5-9-5Zm4 3v4c0 1.5 2.5 3 5 3s5-1.5 5-3v-4' },
    { title: 'Longo curso', text: 'Ásia, América do Sul, Estados Unidos. Capitais médicos elevados e transporte sanitário de qualquer ponto do mundo.', href: '/blog/destinos-asiaticos-em-alta', icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-9-9h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3Z' },
    { title: 'Estadias longas', text: 'Sabáticas, nómadas digitais e meses fora. Proteção contínua para além dos limites de um seguro de férias.', href: '/cotacao?purpose=nomada', icon: 'M8 3v3m8-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z' }
];

const coverages = [
    ['Despesas médicas', 'Consultas, exames, cirurgia e internamento por doença súbita ou acidente.'],
    ['Repatriamento', 'Transporte sanitário para o hospital adequado ou de regresso a Portugal.'],
    ['Assistência 24h', 'Uma equipa que atende, encaminha e paga diretamente aos prestadores.'],
    ['Cancelamento', 'Reembolso das despesas já pagas quando um motivo coberto o impede de viajar.'],
    ['Bagagem', 'Perda, roubo ou atraso da bagagem e compras de primeira necessidade.'],
    ['Responsabilidade civil', 'Danos causados involuntariamente a terceiros durante a viagem.']
];

const faqs = [
    ['Preciso de seguro de viagem se tenho o Cartão Europeu de Seguro de Doença?', 'O cartão dá acesso ao sistema público dos países europeus, mas não cobre hospitais privados, repatriamento, assistência, bagagem nem cancelamento. Os dois complementam-se.'],
    ['Quando devo contratar o seguro de cancelamento?', 'No momento da reserva. A cobertura de cancelamento só protege contra eventos que ocorram depois da subscrição.'],
    ['Que capital de despesas médicas devo escolher?', 'Depende do destino. Para os Estados Unidos, Canadá, Japão ou Suíça recomendamos capitais muito elevados; para a Europa podem ser mais moderados. Indicamos o adequado em cada proposta.'],
    ['Os seguros cobrem doenças preexistentes?', 'Regra geral, não, ou apenas em situações de agudização súbita e com limites. Declare-as no pedido de cotação para recebermos uma proposta que as tenha em conta.'],
    ['Quem é o mediador responsável?', 'A Viagem Garantida é uma marca da Adler & Rochefort, agente de seguros registado na ASF. Trabalhamos com várias seguradoras, sem exclusividade.']
];

const faqLd = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
};
---

<Layout title={SITE.name} jsonLd={faqLd}>
    <!-- HERO -->
    <section class="paper-grain relative overflow-hidden">
        <div class="container-vg grid items-center gap-14 pb-20 pt-14 lg:grid-cols-[1.15fr_1fr] lg:pt-20">
            <div>
                <span class="eyebrow">Seguros de viagem</span>
                <h1 class="mt-6">
                    Viaje longe.<br /><span class="accent">Volte protegido.</span>
                </h1>
                <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-soft">
                    Despesas médicas, repatriamento, cancelamento e assistência 24h, escolhidos pela qualidade da proteção e não pelo preço mais baixo. Com o aconselhamento de um mediador de seguros registado.
                </p>
                <div class="mt-9 flex flex-wrap gap-3">
                    <a href="/cotacao" class="btn-primary px-7 py-4">Pedir cotação</a>
                    <a href="/coberturas" class="btn-ghost px-7 py-4">Ver coberturas</a>
                </div>
                <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-soft">
                    <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-sea"></span>Mediador registado na ASF</li>
                    <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-sea"></span>Várias seguradoras, sem exclusividade</li>
                    <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-sea"></span>Proposta sem compromisso</li>
                </ul>
            </div>

            <!-- Cartão de embarque / mini cotação -->
            <form action="/cotacao" method="get" class="relative rotate-[0.6deg] rounded-[2rem] bg-white shadow-[0_30px_70px_-35px_rgba(20,33,61,0.55)]">
                <div class="flex items-center justify-between rounded-t-[2rem] bg-ink px-7 py-5 text-paper">
                    <span class="text-xs font-semibold uppercase tracking-[0.25em]">Cartão de embarque</span>
                    <span class="font-serif text-lg italic text-sunset">cotação</span>
                </div>
                <div class="space-y-5 p-7">
                    <div class="flex items-end justify-between gap-4">
                        <div>
                            <p class="field-label">De</p>
                            <p class="text-3xl font-bold tracking-tight">PT</p>
                        </div>
                        <span class="route-line mb-3 h-1 grow text-sunset" aria-hidden="true"></span>
                        <svg width="22" height="22" viewBox="0 0 24 24" class="mb-1.5 text-sunset" fill="currentColor" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5Z"></path></svg>
                    </div>
                    <div>
                        <label class="field-label" for="h-destination">Para onde vai?</label>
                        <select id="h-destination" name="destinos" class="field">
                            <option value="">Escolha o país</option>
                            {COUNTRIES.filter((c) => c.code !== 'PT').map((c) => <option value={c.code}>{c.name}</option>)}
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="field-label" for="h-dep">Partida</label>
                            <input id="h-dep" type="date" name="departureDate" class="field" />
                        </div>
                        <div>
                            <label class="field-label" for="h-ret">Regresso</label>
                            <input id="h-ret" type="date" name="returnDate" class="field" />
                        </div>
                    </div>
                    <div class="grid grid-cols-[1fr_auto] items-end gap-4">
                        <div>
                            <label class="field-label" for="h-trav">Viajantes</label>
                            <select id="h-trav" name="viajantes" class="field">
                                {Array.from({ length: 8 }, (_, i) => <option value={i + 1}>{i + 1} {i === 0 ? 'pessoa' : 'pessoas'}</option>)}
                            </select>
                        </div>
                        <label class="mb-3 flex items-center gap-2 text-sm">
                            <input type="checkbox" name="cancelamento" value="1" class="h-4 w-4 accent-[#E2600F]" /> Cancelamento
                        </label>
                    </div>
                </div>
                <div class="relative border-t-2 border-dashed border-ink/10 p-7 pt-6">
                    <span class="absolute -left-4 -top-4 h-8 w-8 rounded-full bg-paper" aria-hidden="true"></span>
                    <span class="absolute -right-4 -top-4 h-8 w-8 rounded-full bg-paper" aria-hidden="true"></span>
                    <button class="btn-sunset w-full py-4 text-base" type="submit">Continuar</button>
                </div>
            </form>
        </div>
    </section>

    <!-- POSICIONAMENTO -->
    <section class="border-y border-ink/10 bg-white/50">
        <div class="container-vg grid gap-10 py-16 md:grid-cols-3">
            <div>
                <p class="font-serif text-5xl italic text-sunset">01</p>
                <h3 class="mt-3">Proteção antes de preço</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">Comparamos coberturas, capitais, exclusões e qualidade da assistência. O prémio mais baixo raramente é o seguro que funciona.</p>
            </div>
            <div>
                <p class="font-serif text-5xl italic text-sunset">02</p>
                <h3 class="mt-3">Aconselhamento real</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">Por trás de cada proposta está um mediador de seguros registado, que lê as condições por si e responde às suas perguntas.</p>
            </div>
            <div>
                <p class="font-serif text-5xl italic text-sunset">03</p>
                <h3 class="mt-3">Acompanhamento no sinistro</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">Se algo correr mal, não fica sozinho com a seguradora. Ajudamos a acionar a apólice e a reunir a documentação.</p>
            </div>
        </div>
    </section>

    <!-- PARA QUEM -->
    <section class="container-vg mt-24">
        <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
                <span class="eyebrow">Para quem</span>
                <h2 class="mt-4 max-w-xl">Cada viagem pede um <span class="accent">seguro diferente</span></h2>
            </div>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {
                audiences.map((a) => (
                    <a href={a.href} class="card group flex flex-col transition hover:-translate-y-1 hover:border-sunset/40">
                        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-sunset/10 text-sunset-deep">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={a.icon} /></svg>
                        </span>
                        <h3 class="mt-6">{a.title}</h3>
                        <p class="mt-2 text-sm leading-relaxed text-ink-soft">{a.text}</p>
                        <span class="mt-auto pt-6 text-sm font-semibold text-sunset-deep">Saber mais →</span>
                    </a>
                ))
            }
        </div>
    </section>

    <!-- COBERTURAS -->
    <section class="mt-24 bg-ink py-24 text-paper">
        <div class="container-vg grid gap-14 lg:grid-cols-[1fr_1.6fr]">
            <div>
                <span class="eyebrow !text-sunset">Coberturas</span>
                <h2 class="mt-4 text-paper">O que um bom seguro de viagem <span class="accent !text-sunset">tem de fazer</span></h2>
                <p class="mt-6 text-paper/70">Seis coberturas decidem quase tudo. É por elas que avaliamos cada apólice que propomos.</p>
                <a href="/coberturas" class="btn mt-8 border border-paper/30 text-paper hover:bg-paper hover:text-ink">Ver todas as coberturas</a>
            </div>
            <div class="grid gap-px overflow-hidden rounded-3xl bg-paper/10 sm:grid-cols-2">
                {
                    coverages.map(([t, d], i) => (
                        <div class="bg-ink p-7">
                            <p class="text-xs font-semibold text-sunset">{String(i + 1).padStart(2, '0')}</p>
                            <h3 class="mt-2 text-paper">{t}</h3>
                            <p class="mt-2 text-sm leading-relaxed text-paper/65">{d}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- DESTINOS -->
    <section class="container-vg mt-24">
        <span class="eyebrow">Destinos em alta</span>
        <h2 class="mt-4 max-w-2xl">Para onde os portugueses <span class="accent">estão a viajar</span></h2>
        <div class="mt-12 grid gap-5 md:grid-cols-2">
            <a href="/blog/destinos-asiaticos-em-alta" class="group relative overflow-hidden rounded-[2rem] bg-[#d6e8e4] p-10">
                <p class="font-serif text-6xl italic text-sea/30 sm:text-7xl" aria-hidden="true">Ásia</p>
                <h3 class="mt-6 text-2xl">Japão, Coreia do Sul, Tailândia, Vietname e Bali</h3>
                <p class="mt-3 max-w-md text-sm leading-relaxed text-ink-soft">Custos médicos privados, motas, mergulho e ilhas remotas. O que confirmar antes de partir.</p>
                <span class="mt-8 inline-block text-sm font-semibold text-sea group-hover:underline">Ler o guia →</span>
            </a>
            <a href="/blog/destinos-america-do-sul-em-alta" class="group relative overflow-hidden rounded-[2rem] bg-[#f3d9c4] p-10">
                <p class="font-serif text-5xl italic text-sunset-deep/25 sm:text-6xl" aria-hidden="true">América do Sul</p>
                <h3 class="mt-6 text-2xl">Peru, Colômbia, Argentina, Brasil e Patagónia</h3>
                <p class="mt-3 max-w-md text-sm leading-relaxed text-ink-soft">Altitude, Amazónia, trilhos e grandes distâncias. As coberturas que fazem a diferença.</p>
                <span class="mt-8 inline-block text-sm font-semibold text-sunset-deep group-hover:underline">Ler o guia →</span>
            </a>
        </div>
    </section>

    <!-- CANCELAMENTO -->
    <section class="container-vg mt-24">
        <div class="grid items-center gap-12 rounded-[2rem] border border-ink/10 bg-sand/60 p-8 sm:p-14 lg:grid-cols-2">
            <div>
                <span class="eyebrow">Cancelamento</span>
                <h2 class="mt-4">A viagem começa <span class="accent">no dia da reserva</span></h2>
                <p class="mt-5 leading-relaxed text-ink-soft">
                    Entre a reserva e a partida podem passar meses. Se um motivo coberto — doença, acidente, um problema familiar — o impedir de viajar, o seguro de cancelamento reembolsa o que já pagou e não consegue recuperar.
                </p>
                <a href="/seguro-cancelamento" class="btn-primary mt-8">Como funciona</a>
            </div>
            <ol class="space-y-4">
                {
                    ['Reserva a viagem', 'Subscreve o seguro no mesmo dia', 'Surge um motivo coberto', 'Recebe o reembolso das despesas não recuperáveis'].map((s, i) => (
                        <li class="flex items-center gap-5 rounded-2xl bg-white/80 p-5">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-ink font-semibold text-paper">{i + 1}</span>
                            <span class="font-medium">{s}</span>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>

    <!-- GUIAS -->
    <section class="container-vg mt-24">
        <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
                <span class="eyebrow">Guias</span>
                <h2 class="mt-4">Antes de partir, <span class="accent">leia isto</span></h2>
            </div>
            <a href="/blog" class="btn-ghost">Todos os guias</a>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-3">
            {featured.map((post) => <ArticleCard post={post} />)}
        </div>
    </section>

    <!-- FAQ -->
    <section class="container-vg mt-24 grid gap-12 lg:grid-cols-[1fr_1.6fr]">
        <div>
            <span class="eyebrow">Perguntas frequentes</span>
            <h2 class="mt-4">Respostas <span class="accent">diretas</span></h2>
        </div>
        <div class="divide-y divide-ink/10 border-y border-ink/10">
            {
                faqs.map(([q, a]) => (
                    <details class="group py-6">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold">
                            {q}
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-ink/15 transition group-open:rotate-45">+</span>
                        </summary>
                        <p class="mt-4 max-w-2xl leading-relaxed text-ink-soft">{a}</p>
                    </details>
                ))
            }
        </div>
    </section>

    <CtaBanner />
</Layout>
