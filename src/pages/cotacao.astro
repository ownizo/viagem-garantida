---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../site';
---

<Layout title="Pedir cotação de seguro de viagem" description="Peça uma cotação de seguro de viagem sem compromisso. Indique destino, datas e viajantes e receba uma proposta com as coberturas adequadas.">
    <PageHeader eyebrow="Cotação" title="Conte-nos sobre a" accent="sua viagem" intro="Leva cerca de dois minutos. Analisamos o destino, a duração, os viajantes e as atividades e enviamos-lhe uma proposta com as coberturas adequadas." />

    <section class="container-vg grid gap-10 lg:grid-cols-[1.7fr_1fr]">
        <div><QuoteForm /></div>
        <aside class="space-y-5 lg:sticky lg:top-28 lg:self-start">
            <div class="card">
                <h2 class="text-lg">O que acontece a seguir</h2>
                <ol class="mt-5 space-y-4 text-sm leading-relaxed text-ink-soft">
                    <li class="flex gap-3"><span class="font-serif text-xl italic text-sunset">1</span>Recebemos o seu pedido e confirmamos os dados.</li>
                    <li class="flex gap-3"><span class="font-serif text-xl italic text-sunset">2</span>Comparamos as soluções das seguradoras com quem trabalhamos.</li>
                    <li class="flex gap-3"><span class="font-serif text-xl italic text-sunset">3</span>Enviamos por email a proposta, com o resumo das coberturas e o documento de informação do produto.</li>
                </ol>
            </div>
            <div class="card bg-sand/60">
                <h2 class="text-lg">Prefere escrever-nos?</h2>
                <p class="mt-3 text-sm text-ink-soft">Envie os dados da viagem para <a class="font-semibold text-sunset-deep underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
            </div>
        </aside>
    </section>
</Layout>
