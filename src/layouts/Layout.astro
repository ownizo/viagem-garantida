---
import '../styles/globals.css';
import '@fontsource-variable/montserrat/wght.css';
import '@fontsource/playfair-display/400-italic.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import VisitTracker from '../components/VisitTracker.astro';
import { SITE, OPERATOR, SOCIAL } from '../site';

interface Props {
    title: string;
    description?: string;
    type?: 'website' | 'article';
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
    noindex?: boolean;
}

const { title, description = SITE.description, type = 'website', jsonLd, noindex = false } = Astro.props;
// Com build.format 'file' o pathname de build pode vir como /pagina.html ou /.html: normalizar para URLs limpos.
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/+$/, '') || '/';
const canonical = new URL(cleanPath, SITE.url).toString().replace(/\/$/, cleanPath === '/' ? '/' : '');
const fullTitle = title === SITE.name ? `Comparador de seguros de viagem | ${SITE.name}` : `${title} | ${SITE.name}`;

const orgLd = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    email: SITE.email,
    logo: `${SITE.url}/brand/logo-viagem-garantida.png`,
    description: 'Comparador de seguros de viagem em Portugal, com ofertas ordenadas pela proteção médica. Os seguros são comercializados pela HelloSafe.',
    slogan: SITE.tagline,
    knowsAbout: ['Seguro de viagem', 'Seguro de cancelamento de viagem', 'Seguro de viagem para estudantes', 'Seguro de viagem para famílias', 'Repatriamento', 'Assistência em viagem'],
    sameAs: SOCIAL.map((s) => s.href),
    parentOrganization: { '@type': 'Organization', name: OPERATOR.legalName, legalName: OPERATOR.legalName },
    address: { '@type': 'PostalAddress', streetAddress: 'Av. do Atlântico 16, Esc. 5.07', postalCode: '1990-019', addressLocality: 'Lisboa', addressCountry: 'PT' },
    areaServed: 'PT'
};
const siteLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: 'VG — Comparador de seguros de viagem',
    url: SITE.url,
    inLanguage: 'pt-PT',
    publisher: { '@type': 'Organization', name: SITE.name }
};
const isHome = cleanPath === '/';
const ldBlocks = [orgLd, ...(isHome ? [siteLd] : []), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="pt-PT">
    <head>
        <!-- Google Consent Mode v2: tudo recusado por omissão; atualizado pelo banner de cookies (vg-consent) -->
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', wait_for_update: 500 });
            try {
                var vgc = JSON.parse(localStorage.getItem('vg-consent') || 'null');
                if (vgc && vgc.v === 1) gtag('consent', 'update', { analytics_storage: vgc.analytics ? 'granted' : 'denied', ad_storage: vgc.marketing ? 'granted' : 'denied', ad_user_data: vgc.marketing ? 'granted' : 'denied', ad_personalization: vgc.marketing ? 'granted' : 'denied' });
            } catch (e) {}
            dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        </script>
        <!-- Etiqueta Google (GTM-W5L5XJB4) -->
        <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-W5L5XJB4"></script>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex" />}
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="alternate" type="text/plain" title="Resumo para modelos de linguagem" href="/llms.txt" />
        <meta property="og:image" content={new URL('/brand/logo-viagem-garantida.png', SITE.url).toString()} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="theme-color" content="#14213D" />

        <meta property="og:type" content={type} />
        <meta property="og:locale" content="pt_PT" />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />

        {ldBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    </head>
    <body class="flex min-h-screen flex-col">
        <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">Saltar para o conteúdo</a>
        <Header />
        <main id="conteudo" class="grow"><slot /></main>
        <Footer />
        <CookieBanner />
        <VisitTracker />
    </body>
</html>
