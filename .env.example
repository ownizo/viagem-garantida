PARTNER_ID=

# Notificação interna de novos pedidos (Resend)
RESEND_API_KEY=
QUOTE_NOTIFY_FROM="Viagem Garantida <cotacoes@viagemgarantida.com>"
QUOTE_NOTIFY_TO=insurance@adlerrochefort.com
