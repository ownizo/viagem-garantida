# Definir em Netlify → Project configuration → Environment variables (nunca no repositório)

# Fornecedor ativo: hellosafe (por omissão) | lead-capture
INSURANCE_PROVIDER=hellosafe

# HelloSafe Atlas — chave da API (painel HelloSafe → Técnico → Chaves API)
ATLAS_KEY_ID=            # ak_test_… (sandbox) ou ak_live_… (produção)
ATLAS_SIGNING_SECRET=    # sk_… — mostrado uma única vez
# Só "true" em Deploy Previews: permite usar a chave sandbox (preços fictícios)
ATLAS_ALLOW_SANDBOX=
# Segredo dos webhooks de vendas (painel HelloSafe → Técnico → Webhooks)
ATLAS_WEBHOOK_SECRET=

# Notificação interna de pedidos e vendas (Resend)
RESEND_API_KEY=
QUOTE_NOTIFY_FROM="Viagem Garantida <cotacoes@viagemgarantida.com>"
QUOTE_NOTIFY_TO=insurance@adlerrochefort.com
